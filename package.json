{
  "name": "react-native-dateflow",
  "version": "0.1.0",
  "description": "Pixel-consistent Calendar, TimePicker, DatePicker and DateTimePicker for React Native + Expo (iOS, Android, Web), styled with NativeWind v4.",
  "license": "MIT",
  "author": "Devansh Walia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devansh-Walia/react-native-dateflow.git"
  },
  "homepage": "https://github.com/Devansh-Walia/react-native-dateflow#readme",
  "bugs": {
    "url": "https://github.com/Devansh-Walia/react-native-dateflow/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "nativewind",
    "datepicker",
    "timepicker",
    "datetimepicker",
    "calendar",
    "ios",
    "android",
    "web"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tailwind-preset": "./tailwind.preset.js",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "tailwind.preset.js",
    "theme.css",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ios": "jest --selectProjects ios",
    "test:android": "jest --selectProjects android",
    "test:web": "jest --selectProjects web",
    "verify": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "@date-fns/tz": "^1.2.0",
    "date-fns": "^4.1.0",
    "expo-haptics": ">=14.0.0",
    "nativewind": "^4.2.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.28.0",
    "react-native-reanimated": ">=4.1.0",
    "react-native-worklets": ">=0.5.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "date-fns": "^4.4.0",
    "expo": "~57.0.25",
    "expo-haptics": "~57.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
